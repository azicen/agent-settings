{
  "$schema": "https://app.kilo.ai/config.json",
  "disabled_providers": [
    "kilo"
  ],
  "lsp": true,
  "mcp": {
    "godot": {
      "type": "local",
      "command": [
        "godot-mcp"
      ],
      "enabled": true,
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      }
    },
    "gopls": {
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "metamcp-code": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer sk_xxx"
      },
      "type": "remote",
      "url": "https://mcp.oath.host/metamcp/code/mcp"
    },
    "sem": {
      "command": [
        "sem",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "shadcn": {
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "tsgo": {
      "command": [
        "typescript-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "/home/azicen/.local/bin/codebase-memory-mcp"
      ]
    }
  },
  "provider": {
    "newapi": {
      "name": "NewApi",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai.oath.host/v1",
        "timeout": 6000000,
        "setCacheKey": true
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "attachment": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 264000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "thinking": {
                "budgetTokens": 16000,
                "budget_tokens": 16000,
                "type": "enabled"
              }
            },
            "low": {
              "disabled": true
            },
            "max": {
              "reasoningEffort": "max",
              "thinking": {
                "budgetTokens": 64000,
                "budget_tokens": 64000,
                "type": "enabled"
              }
            },
            "medium": {
              "disabled": true
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "options": {
            "thinking": {
              "type": "enabled"
            }
          },
          "reasoning": true,
          "variants": {
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro",
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "disabled": true
            }
          }
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash",
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 65000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "disabled": true
            }
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "reasoning": true,
          "variants": {
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6-Luna",
          "attachment": true,
          "limit": {
            "context": 1000000,
            "output": 100000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6-Sol",
          "attachment": true,
          "limit": {
            "context": 1000000,
            "output": 100000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6-Terra",
          "attachment": true,
          "limit": {
            "context": 1000000,
            "output": 100000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "limit": {
            "context": 262144,
            "output": 62144
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true
        },
        "kimi-k3": {
          "name": "Kimi K3",
          "limit": {
            "context": 1000000,
            "output": 62144
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "minimax-m3": {
          "name": "MiniMax-M3",
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1000000,
            "output": 131000
          },
          "options": {
            "thinking": {
              "type": "enabled"
            }
          },
          "reasoning": true,
          "variants": {
            "nano": {
              "disabled": true
            },
            "max": {
              "thinking": {
                "type": "enabled"
              }
            }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": {
    "bash": "allow"
  },
  "agent": {
    "orchestrator": {
      "disable": true
    }
  },
  "snapshot": true,
  "compaction": {
    "auto": true
  },
  "auto_collapse_reasoning": true,
  "terminal_command_display": "expanded",
  "instructions": [
    "/home/azicen/.config/kilo/AGENTS.md"
  ],
  "default_agent": "sisyphus",
  "small_model": "newapi/gemini-3.7-flash",
  "hide_prompt_training_models": true,
  "experimental": {
    "batch_tool": true,
    "openTelemetry": true
  },
}
